{
  "name": "zhougong-dream-dictionary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Localized AI dream dictionary based on the classical Zhou Gong Jie Meng (周公解夢). Static site, no build step.",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "fetch:source": "node tools/fetch-source.mjs",
    "build:book": "node tools/build-book.mjs",
    "build:lexicon": "node tools/simplify-lexicon.mjs && node tools/enrich-lexicon.mjs",
    "translate": "node tools/translate-batch.mjs",
    "translate:status": "node tools/translate-batch.mjs --status",
    "validate": "node tools/validate.mjs",
    "test": "node tools/selftest.mjs && node tools/test-ai.mjs && node tools/validate.mjs",
    "test:matcher": "node tools/selftest.mjs",
    "test:ai": "node tools/test-ai.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
